(function_definition declarator: (function_declarator declarator: (identifier) @function)) @context
(function_definition declarator: (pointer_declarator declarator: (function_declarator declarator: (identifier) @function))) @context
(struct_specifier name: (type_identifier) @struct body: (_)) @context
(enum_specifier name: (type_identifier) @enum body: (_)) @context
(union_specifier name: (type_identifier) @struct body: (_)) @context
;; typedef struct/enum/union carry the name on the declarator,
;; so the context must cover the whole type_definition
(type_definition (struct_specifier body: (_)) (type_identifier) @struct) @context
(type_definition (enum_specifier body: (_)) (type_identifier) @enum) @context
(type_definition (union_specifier body: (_)) (type_identifier) @struct) @context
